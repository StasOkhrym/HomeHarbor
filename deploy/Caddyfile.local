# Local-only Caddy configuration. The internal issuer keeps WebAuthn usable on
# test devices without making the development certificate a production secret.
{$CONTROL_DOMAIN} {
	tls internal
	encode zstd gzip
	reverse_proxy control:8080
}

{$RELAY_DOMAIN} {
	tls internal
	reverse_proxy https://relay:8081 {
		transport http {
			tls_trust_pool file /run/secrets/relay_tls_ca
			tls_server_name relay
		}
	}
}
