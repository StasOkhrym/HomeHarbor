[server]
listen_address = ":8080"
public_url = "https://{{ control_domain }}"
[database]
url = "postgres://go_tunnels@postgres:5432/go_tunnels?sslmode=disable"
password_file = "/run/secrets/postgres_password"
[redis]
url = "redis://redis:6379/0"
password_file = "/run/secrets/redis_password"
[auth]
rp_id = "{{ control_domain }}"
rp_origin = "https://{{ control_domain }}"
session_signing_key_file = "/run/secrets/session_signing_key"
ceremony_encryption_key_file = "/run/secrets/ceremony_encryption_key"
session_ttl = "12h"
ceremony_ttl = "5m"
[relay]
public_url = "wss://{{ relay_domain }}/relay/udp/v2"
ticket_key_file = "/run/secrets/relay_ticket_key"
ticket_ttl = "5m"

[networking]
network_id = "{{ network_id | default('home') }}"

[dns]
enabled = true

[security]
# Only the public half of the trusted companion root key is deployed here.
# The matching private age-encrypted key remains on the operator's Mac.
root_public_key_file = "/run/secrets/root_public_key"
trusted_proxy_cidrs = {{ trusted_proxy_cidrs | default([]) | to_json }}

[observability]
metrics_address = ":9090"
