[http.routers.control]
rule = {{ ('Host(`' ~ control_domain ~ '`)') | to_json }}
entryPoints = ["websecure"]
service = "control"
[http.routers.control.tls]
certResolver = "public"
[http.routers.relay]
rule = {{ ('Host(`' ~ relay_domain ~ '`)') | to_json }}
entryPoints = ["websecure"]
service = "relay"
[http.routers.relay.tls]
certResolver = "public"
[http.services.control.loadBalancer]
[[http.services.control.loadBalancer.servers]]
url = "http://control:8080"
[http.services.relay.loadBalancer]
serversTransport = "relay"
[[http.services.relay.loadBalancer.servers]]
url = "https://relay:8081"
[http.serversTransports.relay]
serverName = "relay"
rootCAs = ["/run/secrets/relay_tls_ca"]
